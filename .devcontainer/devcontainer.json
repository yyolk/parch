{
  "name": "parch",
  "image": "ghcr.io/yyolk/parch-devcontainer:latest",
  "remoteUser": "vscode",
  "postCreateCommand": "uv sync --all-groups",
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:/usr/local/bin:${containerEnv:PATH}",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
      }
    }
  }
}
